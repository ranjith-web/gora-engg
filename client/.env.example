# Enquiries are emailed to company.email (src/config/company.js) by default — nothing to set.

# Optional: use a different form-to-email service instead (e.g. a Formspree URL)
VITE_FORM_ENDPOINT=

# Our API (Render). Leave empty in local dev: Vite proxies /api to http://127.0.0.1:8000
VITE_API_URL=https://gora-engg.onrender.com
# Show the /admin area (quotations) in the production build
VITE_ENABLE_ADMIN=true
